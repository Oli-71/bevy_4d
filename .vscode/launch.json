{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'bevy_4d'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=bevy_4d"
                ],
                "filter": {
                    "name": "bevy_4d",
                    "kind": "bin"
                },
                "cwd": "${workspaceFolder}"
            },
            "env": {
                "RUST_BACKTRACE": "1",
                "BEVY_ASSET_ROOT": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "Release executable 'bevy_4d' (release-fast)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--profile=release-fast",
                    "--bin=bevy_4d"
                ],
                "filter": {
                    "name": "bevy_4d",
                    "kind": "bin"
                },
                "cwd": "${workspaceFolder}"
            },
            "env": {
                "RUST_BACKTRACE": "1",
                "BEVY_ASSET_ROOT": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}",
            "args": []
        },
        {
            "name": "Debug unit tests in executable 'bevy_4d'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=bevy_4d"
                ]
            },
            "env": {
                "RUST_BACKTRACE": "1",
                "BEVY_ASSET_ROOT": "${workspaceFolder}"
            }
        }
    ]
}